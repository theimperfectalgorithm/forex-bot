# Copy this file to mcp/.env and fill in real values.
# Generate keys/tokens with:
#   python -c "import secrets; print(secrets.token_hex(16))"
MCP_API_KEY=REPLACE_WITH_A_REAL_32_CHARACTER_KEY

# Port this clone's server listens on. The two VPS clones must differ:
# demo clone (C:\forex-bot) -> 8000, 5ers clone (C:\forex-bot-5ers) -> 8001.
MCP_PORT=8000

# Dashboard (read-only, /dash + /api/*). Use the SAME token on both clones
# so one bookmarked link (http://<vps-ip>:8000/dash?key=<DASH_TOKEN>)
# authorizes the page's fetches to both accounts. Keep this separate from
# MCP_API_KEY -- this token rides in a browser URL, the MCP key never
# should. If unset, /dash and /api/* return 401 (MCP keeps working).
DASH_TOKEN=REPLACE_WITH_ANOTHER_32_CHARACTER_TOKEN

# Tab label shown for this account in the dashboard,
# e.g. "Demo $100k" or "5ers $5k Challenge".
DASH_LABEL=Account
